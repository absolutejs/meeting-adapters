{
  "name": "@absolutejs/meeting-discord",
  "version": "0.0.1-beta.15",
  "description": "Discord voice source adapter for @absolutejs/meeting — a bot joins a Discord voice channel and streams per-participant audio (speakers known, no diarization needed) into the meeting core for live transcription + analysis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/meeting-adapters.git",
    "directory": "discord"
  },
  "homepage": "https://github.com/absolutejs/meeting-adapters/tree/main/discord",
  "bugs": {
    "url": "https://github.com/absolutejs/meeting-adapters/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./compile": {
      "import": "./dist/compile.js",
      "types": "./dist/compile.d.ts"
    },
    "./manifest": {
      "import": "./dist/manifest.js",
      "types": "./dist/manifest.d.ts"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "license": "Apache-2.0",
  "author": "Alex Kahn",
  "absolutejs": {
    "manifestContract": 2,
    "runtimePeers": {
      "@absolutejs/meeting": {
        "artifactImports": [],
        "buildExternals": [
          "@absolutejs/meeting",
          "@absolutejs/meeting/*"
        ],
        "optional": false,
        "range": ">=0.0.1-beta.9 <0.1",
        "tested": "0.0.1-beta.9"
      },
      "@absolutejs/voice": {
        "artifactImports": [],
        "buildExternals": [
          "@absolutejs/voice",
          "@absolutejs/voice/*"
        ],
        "optional": false,
        "range": ">=0.0.22-beta.647 <0.1",
        "tested": "0.0.22-beta.647"
      },
      "@discordjs/voice": {
        "artifactImports": [
          "@discordjs/voice"
        ],
        "buildExternals": [
          "@discordjs/voice",
          "@discordjs/voice/*"
        ],
        "optional": false,
        "range": ">=0.19.2 <0.20",
        "tested": "0.19.2"
      },
      "discord.js": {
        "artifactImports": [
          "discord.js"
        ],
        "buildExternals": [
          "discord.js",
          "discord.js/*"
        ],
        "optional": false,
        "range": ">=14.27.0 <15",
        "tested": "14.27.0"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts ./src/compile.ts ./src/manifest.ts --outdir dist --root src --target bun --external @absolutejs/manifest --external '@absolutejs/manifest/*' --external @absolutejs/meeting --external '@absolutejs/meeting/*' --external @absolutejs/voice --external '@absolutejs/voice/*' --external @discordjs/voice --external '@discordjs/voice/*' --external @sinclair/typebox --external '@sinclair/typebox/*' --external discord.js --external 'discord.js/*' --external prism-media --external 'prism-media/*' --external '@snazzah/*' && tsc --emitDeclarationOnly --project tsconfig.json && absolute-manifest emit",
    "format": "prettier --write \"./**/*.{js,ts,json,md}\"",
    "release": "bun run check:package && npm publish --access public --tag beta",
    "test": "bun test",
    "typecheck": "bun run tsc --noEmit",
    "verify-package": "absolute-manifest verify-package",
    "check:package": "bun run format && bun run typecheck && bun run test && bun run verify-package && bun run build && bun run verify-package --artifacts"
  },
  "peerDependencies": {
    "@absolutejs/meeting": ">=0.0.1-beta.9 <0.1",
    "@absolutejs/voice": ">=0.0.22-beta.647 <0.1",
    "@discordjs/voice": ">=0.19.2 <0.20",
    "discord.js": ">=14.27.0 <15"
  },
  "dependencies": {
    "@absolutejs/manifest": "0.7.2",
    "@sinclair/typebox": "0.34.52",
    "@snazzah/davey-linux-x64-gnu": "0.1.12",
    "prism-media": "1.3.5"
  },
  "devDependencies": {
    "@absolutejs/meeting": "0.0.1-beta.9",
    "@absolutejs/voice": "0.0.22-beta.647",
    "@discordjs/voice": "0.19.2",
    "@types/bun": "1.3.14",
    "discord.js": "14.27.0",
    "elysia": "1.4.29",
    "prettier": "3.9.6",
    "typescript": "^5.9.3"
  }
}
