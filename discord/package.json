{
	"name": "@absolutejs/meeting-discord",
	"version": "0.0.1-beta.13",
	"description": "Discord voice source adapter for @absolutejs/meeting — a bot joins a Discord voice channel and streams per-participant audio (speakers known, no diarization needed) into the meeting core for live transcription + analysis",
	"repository": {
		"type": "git",
		"url": "https://github.com/absolutejs/meeting-adapters.git",
		"directory": "discord"
	},
	"homepage": "https://github.com/absolutejs/meeting-adapters/tree/main/discord",
	"bugs": {
		"url": "https://github.com/absolutejs/meeting-adapters/issues"
	},
	"files": [
		"dist",
		"README.md"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./compile": {
			"import": "./dist/compile.js",
			"types": "./dist/compile.d.ts"
		},
		"./manifest": {
			"import": "./dist/manifest.js",
			"types": "./dist/manifest.d.ts"
		},
		"./manifest.json": "./dist/manifest.json"
	},
	"license": "Apache-2.0",
	"author": "Alex Kahn",
	"absolutejs": {
		"manifestContract": 1
	},
	"scripts": {
		"build": "rm -rf dist && bun build ./src/index.ts ./src/compile.ts ./src/manifest.ts --outdir dist --root src --target bun --external @absolutejs/voice --external @absolutejs/meeting --external discord.js --external @discordjs/voice --external prism-media --external '@snazzah/*' && tsc --emitDeclarationOnly --project tsconfig.json && absolute-manifest emit",
		"format": "prettier --write \"./**/*.{js,ts,json,md}\"",
		"release": "bun run build && bun publish",
		"test": "bun test",
		"typecheck": "bun run tsc --noEmit"
	},
	"peerDependencies": {
		"@absolutejs/meeting": ">=0.0.1-beta.5",
		"@absolutejs/voice": ">=0.0.22-beta.550",
		"@discordjs/voice": ">=0.17.0",
		"discord.js": ">=14.0.0"
	},
	"dependencies": {
		"@absolutejs/manifest": "^0.1.0",
		"@sinclair/typebox": "^0.34.0",
		"@snazzah/davey-linux-x64-gnu": "^0.1.11",
		"prism-media": "^1.3.5"
	},
	"devDependencies": {
		"@absolutejs/meeting": "0.0.1-beta.5",
		"@absolutejs/voice": "0.0.22-beta.550",
		"@discordjs/voice": "^0.19",
		"@types/bun": "1.3.9",
		"discord.js": "^14.16.3",
		"prism-media": "^1.3.5",
		"typescript": "^5.9.3"
	}
}
